# Copy to .env and adjust as needed. All variables are optional — sane
# defaults are baked into config.py.

NEUROFEED_ENV=development
NEUROFEED_LOG_LEVEL=INFO

# Local SQLite databases and DDQN model checkpoints (configurable)
# NEUROFEED_DB_PATH=final/data/news_recommender.sqlite
# NEUROFEED_AUTH_DB_PATH=final/data/auth.sqlite
# NEUROFEED_MODEL_DIR=final/models

# Comma-separated list of allowed CORS origins (* for local development)
NEUROFEED_CORS_ORIGINS=*

# Set to true to start OpenCV/MediaPipe webcam attention worker
# (graceful fallback to neutral attention if no camera is available)
NEUROFEED_ENABLE_WEBCAM_ATTENTION=false

# Recommender tuning
NEUROFEED_COLD_START_INTERACTION_THRESHOLD=5
NEUROFEED_MMR_LAMBDA=0.75
NEUROFEED_MAX_CACHED_AGENTS=500

# Cache and API rate limits
NEUROFEED_CACHE_TTL_SECONDS=30
NEUROFEED_RATE_LIMIT_REQUESTS=120
NEUROFEED_RATE_LIMIT_WINDOW_SECONDS=60

# Stricter limiter applied to /auth/signup and /auth/login
NEUROFEED_AUTH_RATE_LIMIT_REQUESTS=10
NEUROFEED_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Per-account login lockout after repeated failures
NEUROFEED_LOGIN_MAX_FAILURES=5
NEUROFEED_LOGIN_FAILURE_WINDOW_SECONDS=300
NEUROFEED_LOGIN_LOCKOUT_SECONDS=60

# Real News Ingestion (NewsData.io) — free key at https://newsdata.io
NEWSDATA_API_KEY=
NEUROFEED_NEWSDATA_DAILY_CREDIT_LIMIT=180
NEUROFEED_NEWS_INGEST_COUNTRIES=in,us,gb
NEUROFEED_NEWS_INGEST_CATEGORIES=business,education,entertainment,health,lifestyle,politics,science,sports,technology,world,top
NEUROFEED_NEWS_INGEST_LANGUAGES=en
NEUROFEED_NEWS_INGEST_SINCE=48h
NEUROFEED_NEWS_INGEST_TARGET_PER_CATEGORY=40
NEUROFEED_NEWS_CATEGORY_MIN_CONFIDENCE=0.50
NEUROFEED_REFRESH_INTERVAL_HOURS=24.0
NEUROFEED_FEED_RECENCY_DAYS=3
NEUROFEED_MAX_ARTICLE_AGE_DAYS=14

# Reinforcement Learning tuning
NEUROFEED_DDQN_MIN_REPLAY=8
NEUROFEED_DDQN_GAMMA=0.9

# Live News bulletin (NewsAPI.org key, optional)
NEUROFEED_NEWS_API_KEY=
NEUROFEED_NEWS_API_COUNTRY=us
NEUROFEED_NEWS_API_PAGE_SIZE=12
NEUROFEED_NEWS_LIVE_CACHE_TTL_SECONDS=5400
